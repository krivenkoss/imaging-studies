# Repository of the algorithmic core. Project documents live one level above
# and have their own repository.

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Environments and tool caches -----------------------------------------
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
# Derived notebook copies JupyterLab writes for editor hints. `git add -A`
# would take them; nobody wrote them.
.virtual_documents/
# JupyterLab runtime/data dirs when the launcher redirects them next to core/.
# They hold notebook_secret, cookie secrets and live-kernel files: a secret in
# history is removed only by rewriting history.
.jupyter/

# --- Secrets -------------------------------------------------------------
.env
*.pem
*.key
secrets.*
credentials.*

# --- OS and editors -------------------------------------------------------
# Editor workspace files carry machine-specific paths (the owner's venv);
# this repository is public, so they stay local.
.vscode/
*.code-workspace
# Local JupyterLab launchers name and activate the owner's venv (a machine path).
run_jupyterlab_*.bat

.DS_Store
Thumbs.db
desktop.ini
~$*

# Working task and report of the executor (owner decision 2026-10-13):
# internal, not for the public repository.
prompts/

# =========================================================================
# WHAT MUST NOT APPEAR HERE, AND WHY
#
# No blanket rules like *.csv, *.npy, *.json, *.png, *.bmp, fixtures/ or tests/data/.
# Reference vectors and small test images are stored AS BYTES
# (REFERENCE.md#ref-verify); a rule by extension would destroy them, and a check would become a
# comparison of the code with itself. Large intermediate dumps are excluded BY
# NAME, by concrete path, with a note on how they differ from the reference.
# =========================================================================

# The home of dataset paths for THIS machine (../CLAUDE.md R08). The form is
# documented beside it in lab_paths.example.json, which IS in history.
lab_paths.json

# Cases built from medical (dental) images. Whether they may travel is the
# owner's decision (../REFERENCE.md#open-data); until then `git add -A` must not
# take them. Adjust the pattern to the case naming convention.
examples/cases/*_dental_*
examples/expected/*_dental_*

# Reproducibility archives for papers and their staging tree: built by a script
# from `git archive`, sent by the owner with a submission.
release/staging/
release/*.zip

# Generated by the runs: books, pages, figures. Rebuilt from the run files, large, and
# they may carry medical image names in captions - outside Git by design.
reports/
release/figures/

# Codec executables built by tools/build_coders.ps1 from pinned archives
# (third_party/coders.json); rebuilt, never committed. tools/build/ is covered by build/.
tools/bin/

# Image sets live OUTSIDE this repository (../Images, ../data).
# Local laboratory cache lives OUTSIDE this repository (../tmp/, see
# lab_paths.example.json cache_root) and needs no rule here. If a cache is ever
# placed inside core/, exclude it by its concrete path, not by extension.
